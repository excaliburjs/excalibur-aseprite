{
  "name": "@excaliburjs/plugin-aseprite",
  "version": "1.0.0-alpha.0",
  "description": "Aseprite Resource Plugin for Excalibur",
  "main": "./build/esm/excalibur-aseprite.js",
  "typings": "./build/esm/src/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git://github.com/excaliburjs/excalibur-aseprite.git"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./build/esm/src/index.d.ts",
      "import": "./build/esm/excalibur-aseprite.min.js"
    }
  },
  "scripts": {
    "start": "vite example",
    "watch": "vite dev",
    "types": "tsc --project tsconfig.json --declaration --emitDeclarationOnly",
    "type-check": "tsc --noEmit",
    "build:esm": "vite build && vite build --minify false",
    "build": "npm run build:esm && npm run types",
    "test:unit": "vitest --project unit",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "author": "Erik Onarheim",
  "license": "BSD-2-Clause",
  "bugs": {
    "url": "https://github.com/excaliburjs/excalibur-aseprate/issues"
  },
  "homepage": "https://github.com/excaliburjs/excalibur-aseprate#readme",
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/jasmine": "5.1.15",
    "@types/node": "24.13.3",
    "@vitest/browser-playwright": "5.0.3",
    "excalibur": "0.33.0-alpha.247",
    "typescript": "5.9.3",
    "vite": "8.1.4",
    "vite-plugin-node-polyfills": "0.28.0",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "excalibur": ">=0.33.0-alpha.247"
  },
  "dependencies": {
    "pako": "3.0.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "error",
      "version": ">=24"
    },
    "packageManager": {
      "name": "npm",
      "onFail": "error",
      "version": ">=11"
    }
  }
}
